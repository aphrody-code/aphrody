# aphrody — environment variables template (committed, NO secrets here)
# ============================================================================
# Copy this file to `.env` and fill in the actual values. `.env` is git-
# ignored (see .gitignore §7), `.env.example` IS tracked as the canonical
# list of variables consumed by aphrody and its sub-commands.
# ============================================================================

# ── X / Twitter ─────────────────────────────────────────────────────────────
# Target account: https://x.com/aphrody_code (the autonomous-agent account,
# cf. memory reference_aphrody_x_handle, distinct from the maintainer's
# personal account).
#
# Where to get the values:
#   1. https://developer.x.com/en/portal/dashboard → create / open an App
#   2. "Keys and tokens" tab
#      - Bearer Token         → X_BEARER_TOKEN          (read-only, app-auth)
#      - Consumer Keys        → X_API_KEY + X_API_SECRET (OAuth 1.0a, write)
#      - Access Token & Secret → X_ACCESS_TOKEN + _SECRET (acts as the user)
#      - OAuth 2.0 Client ID/Secret → optional, for user-context OAuth flow
#
# Minimum to READ public profile/tweets via api.x.com/2/*:
#     X_BEARER_TOKEN
# Minimum to POST as @aphrody_code:
#     X_API_KEY + X_API_SECRET + X_ACCESS_TOKEN + X_ACCESS_TOKEN_SECRET

X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_HANDLE=aphrody_code

# ── Aphrody runtime overrides (non-secret) ──────────────────────────────────
# Override the PATH resolution of bundled external binaries. Useful for
# packaged installs or unusual layouts. All optional — defaults to `which`
# resolution.
#
# APHRODY_N2B_BIN=/usr/local/bin/n2b
# APHRODY_GEMINI_BIN=/usr/local/bin/gemini
# APHRODY_COORD_DIR=/var/run/aphrody-coord    # A2A mailbox dir (default: C:/winclean/.coord)
# BXC_DAEMON_URL=http://127.0.0.1:8765        # bxc-mcp daemon target
# BXC_TIMEOUT_MS=30000                        # bxc-mcp HTTP request timeout
# BXC_VISION_MIN_BYTES=4096                   # bxc vision_analyze guard

# ── GCP service account (ADC) ───────────────────────────────────────────────
# Service account `aphrody-bot@aphrody.iam.gserviceaccount.com` (roles/owner).
# Run `scripts/gcp-sa-setup.ps1` (Windows) or `scripts/gcp-sa-setup.sh` (Linux)
# to (re)generate the JSON key into `secrets/` and populate `.env`.
# The key file is gitignored (see .gitignore §7) — NEVER commit it.
GOOGLE_APPLICATION_CREDENTIALS=secrets/aphrody-bot.json
GOOGLE_CLOUD_PROJECT=aphrody
GCLOUD_PROJECT=aphrody
CLOUDSDK_CORE_PROJECT=aphrody
GCP_SERVICE_ACCOUNT=aphrody-bot@aphrody.iam.gserviceaccount.com
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_REGION=us-central1
# Clé API GCP non restreinte (display-name aphrody-full) — generativelanguage/Gemini, Maps, Custom Search.
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ── Firebase configuration ──────────────────────────────────────────────────
# Firebase Web SDK configuration keys for the client app.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
