{
  "$schema": "https://opencode.ai/tui.json",
  "theme": "tokyonight",
  "scroll_speed": 3,
  "scroll_acceleration": {
    "enabled": true
  },
  "diff_style": "auto",
  "keybinds": {
    "quit": "q",
    "yank": "y",
    "paste": "p",
    "delete": "d",
    "undo": "u",
    "scroll_up": "k",
    "scroll_down": "j",
    "scroll_page_up": "ctrl+b",
    "scroll_page_down": "ctrl+f",
    "goto_top": "gg",
    "goto_bottom": "G",
    "submit": "enter",
    "cancel": "escape"
  }
}
