{
  "name": "aphrody",
  "version": "1.0.0-canary",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "cargo run -p aphrody --locked --",
    "start:terminal": "cargo run -p backend --release --locked & cargo run -p gui --release --locked",
    "build:all": "turbo run build",
    "build:rust": "cargo build --workspace --locked",
    "build:rust:release": "cargo build --workspace --locked --profile dist",
    "lint:all": "turbo run lint --filter=!@electron-ci/dev-root",
    "lint:rust": "cargo ci-offline",
    "check:rust": "cargo check --workspace --locked",
    "audit:supply-chain": "cargo deny check && cargo vet",
    "audit:unused": "cargo audit-machete && cargo audit-udeps",
    "docs:summary": "cargo run -p aphrody-summary",
    "docs:summary:check": "cargo run -p aphrody-summary -- --check",
    "skills:list": "cargo run -q -p aphrody-skills-runtime --bin agent-skills -- list ./.claude/plugins/aphrody/skills",
    "skills:validate": "cargo run -q -p aphrody-skills-runtime --bin agent-skills -- validate ./.claude/plugins/aphrody/skills",
    "skills:to-prompt": "cargo run -q -p aphrody-skills-runtime --bin agent-skills -- to-prompt ./.claude/plugins/aphrody/skills/analyze",
    "skills:sync:vercel": "cargo xtask skills-sync vercel-labs/agent-skills",
    "skills:sync:claude-official": "cargo xtask skills-sync anthropics/skills",
    "optimize:assets": "bun run scripts/optimize-assets.ts",
    "optimize:full": "bun run optimize:assets && turbo run build"
  },
  "catalog": {
    "zod": "^3.23.8",
    "@modelcontextprotocol/sdk": "^1.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
