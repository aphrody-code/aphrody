{
  "name": "@aphrody-code/console",
  "version": "1.0.0-canary",
  "private": true,
  "description": "aphrody console — a live, M3-styled web UI that drives the ENTIRE aphrody CLI in-process. A Bun server backed by @aphrody-code/native (bun:ffi) exposes a local API; the browser frontend runs real commands and shows real output. No subprocess, no stub.",
  "keywords": [
    "aphrody",
    "console",
    "material-3",
    "bun",
    "ffi"
  ],
  "homepage": "https://github.com/aphrody-code/aphrody-ts/tree/main/apps/console#readme",
  "bugs": {
    "url": "https://github.com/aphrody-code/aphrody/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-code/aphrody-ts.git",
    "directory": "apps/console"
  },
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "lint": "oxlint",
    "fmt": "oxfmt src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aphrody-code/native": "workspace:*",
    "@aphrody-code/theme": "workspace:*"
  },
