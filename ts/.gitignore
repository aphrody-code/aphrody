# Bun / TS build artifacts and caches — reproducible, never tracked.
node_modules/
dist/
.wireit/
*.tsbuildinfo
.turbo/
target/

# ----------------------------------------------------------------------------
# UI forks under packages/* keep their OWN .git and native package managers
# (npm/pnpm). They are intentionally NOT tracked by this repo to avoid
# accidental gitlink embedding — each fork is pushed to its own
# aphrody-code/* remote. Drop a `!packages/<name>/` negation to vendor one.
# ----------------------------------------------------------------------------
packages/
.npmrc
bin/
