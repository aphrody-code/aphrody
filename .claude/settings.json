      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(gh release download:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh run rerun:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow run:*)",
      "Bash(gh api:*)",
      "Bash(gh auth status:*)",
      "Bash(gh auth token:*)",
      "Bash(gh label list:*)",
      "Bash(gh secret list:*)",

      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(jq:*)",
      "Bash(yq:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
