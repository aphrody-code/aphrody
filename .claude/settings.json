      "Bash(git config --list:*)",

      "Bash(gh repo view:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo list:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
