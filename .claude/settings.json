{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo test:*)",
      "Bash(cargo run:*)",
      "Bash(cargo doc:*)",
      "Bash(rustup:*)",
      "Bash(rustfmt:*)",
      "Bash(bun install:*)",
      "Bash(bun run:*)",
      "Bash(bun test:*)",
      "Bash(bun x:*)",
      "Bash(bunx:*)",
      "Bash(cmake:*)",
      "Bash(clang-format:*)",
      "Bash(clang-tidy:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)",
      "Read(./**/credentials*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)"
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false
  }
}
