    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)",
      "Read(./**/credentials*)",
      "Read(./**/id_rsa*)",
      "Read(./**/id_ed25519*)",
      "Read(./**/.aws/**)",
      "Read(./**/.ssh/**)",
      "Read(./**/.gnupg/**)",

      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf $HOME*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(git clean -fdx:*)",
      "Bash(git branch -D:*)",
      "Bash(git config --global:*)",
      "Bash(git config user.email:*)",
      "Bash(git config user.name:*)",
      "Bash(git rebase -i:*)",
      "Bash(git add -i:*)",
      "Bash(npm publish:*)",
      "Bash(cargo publish:*)",
      "Bash(cargo install:*)",
      "Bash(curl * | sh:*)",
      "Bash(curl * | bash:*)",
      "Bash(curl * | iex:*)",
      "Bash(irm * | iex:*)",
      "Bash(sudo:*)",
      "Bash(chmod 777:*)",
      "Bash(dd if:*)",
      "Bash(mkfs:*)",
      "Bash(format:*)"
    ]
  },

  "env": {
    "_comment_env": "Generous timeouts/output for autonomous long-running tasks. Disable telemetry on user request.",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "BASH_MAX_OUTPUT_LENGTH": "60000",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "0",
    "DISABLE_TELEMETRY": "0"
  },

  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false
  }
}
