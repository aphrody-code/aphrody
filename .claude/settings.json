      "Bash(rustc --print:*)",

      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(wasm-pack:*)",
      "Bash(wasm-bindgen:*)",
      "Bash(wasm-tools:*)",
      "Bash(wasmtime:*)",
      "Bash(npx:*)",

      "Bash(cmake:*)",
      "Bash(clang-format:*)",
      "Bash(clang-tidy:*)",
      "Bash(ninja:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git fetch:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
