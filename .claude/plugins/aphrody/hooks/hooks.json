{
  "$schema": "https://code.claude.com/schema/hooks.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cargo check --workspace --message-format json --locked --offline",
            "timeout": 60000
          },
          {
            "type": "command",
            "command": "cargo xtask toml-validate",
            "timeout": 30000
          }
        ]
      }
    ]
  }
}
