{
  "$schema": "https://code.claude.com/schema/plugin.json",
  "name": "aphrody",
  "version": "0.6.0",
  "description": "Pure-Rust single-MCP-server automation surface for Claude Code. ONE native binary `aphrody-mcp` (6.5 MB, sub-millisecond cold-start) fuses 15 tools — 8 from ex-google_mcp (coding_style_guide, universal_web_fetch, dns_recon, auth_extract, chrome_autopsy, advanced_recon, native_hooks, start_dashboard) + 7 from ex-bxc-mcp (bxc_scrape, bxc_recon, bxc_detect, google_search, google_atlas_route, extract_structured, vision_analyze). Zero JS runtime, zero subprocess relay. 3 slash commands (/scrape, /tokens, /status). 27 agents, 35+ skills. PostToolUse hooks. Cross-platform: Linux #1, Windows #2, WASM #3.",
  "author": {
    "name": "aphrody-code",
    "email": "37252373+aphrody-code@users.noreply.github.com",
    "url": "https://github.com/aphrody-code"
  },
  "homepage": "https://github.com/aphrody-code/aphrody",
  "repository": "https://github.com/aphrody-code/aphrody",
  "license": "Apache-2.0",
  "keywords": [
    "aphrody",
    "material-design-3",
    "shadcn",
    "bxc",
    "scraping",
    "n2b",
    "bun",
    "oxlint",
    "rust",
    "cross-platform",
    "wasm",
    "claude-code"
  ],
  "category": "productivity",
  "skills": "./skills/",
  "commands": [
    "./commands/scrape.md",
    "./commands/tokens.md",
    "./commands/status.md"
  ],
  "agents": [
    "./agents/aphrody-cli.md",
    "./agents/build.md",
    "./agents/cargo-auditor.md",
    "./agents/code-review.md",
    "./agents/cpp-engineer.md",
    "./agents/cross-platform-validator.md",
    "./agents/deployment-engineer.md",
    "./agents/design-google-curator.md",
    "./agents/devops-engineer.md",
    "./agents/discord-bot.md",
    "./agents/explore.md",
    "./agents/ffi-architect.md",
    "./agents/incident-responder.md",
    "./agents/m3-spec-auditor.md",
    "./agents/material.md",
    "./agents/move.md",
    "./agents/n2b-contract-guard.md",
    "./agents/n2b-ultra.md",
    "./agents/n2b.md",
    "./agents/performance-engineer.md",
    "./agents/postgres-pro.md",
    "./agents/rust-architect.md",
    "./agents/rust-engineer.md",
    "./agents/security-engineer.md",
    "./agents/sre-engineer.md",
    "./agents/yolo-prod-ready.md",
    "./agents/zig-engineer.md"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "aphrody": {
      "type": "stdio",
      "command": "aphrody-mcp",
      "args": [],
      "env": {
        "BXC_DAEMON_URL": "http://127.0.0.1:8765",
        "BXC_TIMEOUT_MS": "30000",
        "BXC_VISION_MIN_BYTES": "1024"
      }
    }
  }
}
