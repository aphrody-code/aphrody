{
  "$schema": "https://code.claude.com/schema/plugin.json",
  "name": "aphrody",
  "version": "0.5.1",
  "description": "Single-MCP-server automation surface for Claude Code. ONE `aphrody` stdio server fuses 18 tools across 3 first-party domains : (1) scraping via bxc-mcp Rust subprocess (7), (2) in-process SQLite memory (3), (3) aphrody CLI wrappers — doctor/version/dns/notify/scan_tree/scan_manifests/chromium_sync/a2a_prompt (8). Third-party MCPs (github, context7) are NOT bundled — install them separately. 3 slash commands (/scrape, /tokens, /status). 27 agents, 35+ skills. PostToolUse hooks. MCPB-packageable. Cross-platform: Linux #1, Windows #2, WASM #3.",
  "author": {
    "name": "aphrody-code",
    "email": "37252373+aphrody-code@users.noreply.github.com",
    "url": "https://github.com/aphrody-code"
  },
  "homepage": "https://github.com/aphrody-code/aphrody",
  "repository": "https://github.com/aphrody-code/aphrody",
  "license": "Apache-2.0",
  "keywords": [
    "aphrody",
    "material-design-3",
    "shadcn",
    "bxc",
    "scraping",
    "n2b",
    "bun",
    "oxlint",
    "rust",
    "cross-platform",
    "wasm",
    "claude-code"
  ],
  "category": "productivity",
  "skills": "./skills/",
  "commands": [
    "./commands/scrape.md",
    "./commands/tokens.md",
    "./commands/status.md"
  ],
  "agents": [
    "./agents/aphrody-cli.md",
    "./agents/build.md",
    "./agents/cargo-auditor.md",
    "./agents/code-review.md",
    "./agents/cpp-engineer.md",
    "./agents/cross-platform-validator.md",
    "./agents/deployment-engineer.md",
    "./agents/design-google-curator.md",
    "./agents/devops-engineer.md",
    "./agents/discord-bot.md",
    "./agents/explore.md",
    "./agents/ffi-architect.md",
    "./agents/incident-responder.md",
    "./agents/m3-spec-auditor.md",
    "./agents/material.md",
    "./agents/move.md",
    "./agents/n2b-contract-guard.md",
    "./agents/n2b-ultra.md",
    "./agents/n2b.md",
    "./agents/performance-engineer.md",
    "./agents/postgres-pro.md",
    "./agents/rust-architect.md",
    "./agents/rust-engineer.md",
    "./agents/security-engineer.md",
    "./agents/sre-engineer.md",
    "./agents/yolo-prod-ready.md",
    "./agents/zig-engineer.md"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "aphrody": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "${CLAUDE_PLUGIN_ROOT}/mcp/aphrody/server/index.ts"
      ],
      "env": {
        "BXC_DAEMON_URL": "http://127.0.0.1:8765",
        "BXC_MEMORY_DB": "${HOME}/.aphrody/aphrody-memory.sqlite",
        "APHRODY_BIN": "aphrody",
        "BXC_MCP_BIN": "bxc-mcp"
      }
    }
  }
}
