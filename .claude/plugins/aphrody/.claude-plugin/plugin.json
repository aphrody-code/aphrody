{
  "$schema": "https://code.claude.com/schema/plugin.json",
  "name": "aphrody",
  "version": "0.2.0",
  "description": "aphrody plugin: skills (pixel-perfect, rust-target-check, m3-component), agents (n2b-ultra, cross-platform-validator, m3-spec-auditor), /scrape and /tokens slash commands powered by the bxc-scrapper MCP server, and PostToolUse hooks (oxlint, cargo-check, cargo-toml-validate). Cross-platform (Linux #1, Windows #2, WASM #3), Bun-only, zero stubs.",
  "author": {
    "name": "aphrody-code",
    "email": "37252373+aphrody-code@users.noreply.github.com",
    "url": "https://github.com/aphrody-code"
  },
  "homepage": "https://github.com/aphrody-code/aphrody",
  "repository": "https://github.com/aphrody-code/aphrody",
  "license": "Apache-2.0",
  "keywords": [
    "aphrody",
    "material-design-3",
    "shadcn",
    "bxc",
    "scraping",
    "n2b",
    "bun",
    "oxlint",
    "rust",
    "cross-platform",
    "wasm",
    "claude-code"
  ],
  "category": "productivity",
  "skills": "./skills/",
  "commands": [
    "./commands/scrape.md",
    "./commands/tokens.md",
    "./commands/status.md"
  ],
  "agents": [
    "./agents/build.md",
    "./agents/bun-api.md",
    "./agents/bun-deployer.md",
    "./agents/bun-dreamer.md",
    "./agents/bun-explorer.md",
    "./agents/bun-native.md",
    "./agents/bun-reviewer.md",
    "./agents/bun-runner.md",
    "./agents/bun-wasm.md",
    "./agents/bun-web-api.md",
    "./agents/cargo-auditor.md",
    "./agents/code-review.md",
    "./agents/cpp-engineer.md",
    "./agents/cross-platform-validator.md",
    "./agents/deployment-engineer.md",
    "./agents/design-google-curator.md",
    "./agents/devops-engineer.md",
    "./agents/discord-bot.md",
    "./agents/explore.md",
    "./agents/ffi-architect.md",
    "./agents/incident-responder.md",
    "./agents/m3-spec-auditor.md",
    "./agents/material.md",
    "./agents/move.md",
    "./agents/n2b-contract-guard.md",
    "./agents/n2b-ultra.md",
    "./agents/n2b.md",
    "./agents/nextjs-developer.md",
    "./agents/performance-engineer.md",
    "./agents/postgres-pro.md",
    "./agents/rust-architect.md",
    "./agents/rust-engineer.md",
    "./agents/security-engineer.md",
    "./agents/sre-engineer.md",
    "./agents/typescript-pro.md",
    "./agents/yolo-prod-ready.md",
    "./agents/zig-engineer.md"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "bxc-scrapper": {
      "type": "stdio",
      "command": "cargo",
      "args": [
        "run",
        "--quiet",
        "--release",
        "-p",
        "bxc-engine",
        "--bin",
        "bxc-mcp"
      ],
      "env": {
        "BXC_DAEMON_URL": "http://127.0.0.1:8765"
      }
    },
    "github": {
      "type": "streamable-http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "bxc": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "C:/worktree/bxc/packages/bxc-extension/server.ts"
      ],
      "env": {
        "BXC_MEMORY_DB": "C:/src/aphrody/var/data/bxc-memory.sqlite"
      }
    },
    "context7": {
      "httpUrl": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}",
        "Accept": "application/json, text/event-stream"
      }
    }
  }
}
