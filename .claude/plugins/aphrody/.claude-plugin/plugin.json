{
  "$schema": "https://code.claude.com/schema/plugin.json",
  "name": "aphrody",
  "version": "0.3.0",
  "description": "aphrody plugin: unified bxc/n2b/aphrody CLI integration. Slash commands /scrape, /tokens, /status drive the aphrody binary (auto-start bxc Bun daemon, /api/* routes, native schema). Agents (aphrody-cli, n2b-*, m3-*, cross-platform-validator, yolo-prod-ready, …) + skills (pixel-perfect, m3-component, agent-browser, …) + PostToolUse hooks (cargo check, cargo xtask toml-validate). Two MCP servers: bxc-scrapper (Rust, 7 scraping tools) + bxc (Bun, memory/vision/CDP). Cross-platform (Linux #1, Windows #2, WASM #3).",
  "author": {
    "name": "aphrody-code",
    "email": "37252373+aphrody-code@users.noreply.github.com",
    "url": "https://github.com/aphrody-code"
  },
  "homepage": "https://github.com/aphrody-code/aphrody",
  "repository": "https://github.com/aphrody-code/aphrody",
  "license": "Apache-2.0",
  "keywords": [
    "aphrody",
    "material-design-3",
    "shadcn",
    "bxc",
    "scraping",
    "n2b",
    "bun",
    "oxlint",
    "rust",
    "cross-platform",
    "wasm",
    "claude-code"
  ],
  "category": "productivity",
  "skills": "./skills/",
  "commands": [
    "./commands/scrape.md",
    "./commands/tokens.md",
    "./commands/status.md"
  ],
  "agents": [
    "./agents/aphrody-cli.md",
    "./agents/build.md",
    "./agents/cargo-auditor.md",
    "./agents/code-review.md",
    "./agents/cpp-engineer.md",
    "./agents/cross-platform-validator.md",
    "./agents/deployment-engineer.md",
    "./agents/design-google-curator.md",
    "./agents/devops-engineer.md",
    "./agents/discord-bot.md",
    "./agents/explore.md",
    "./agents/ffi-architect.md",
    "./agents/incident-responder.md",
    "./agents/m3-spec-auditor.md",
    "./agents/material.md",
    "./agents/move.md",
    "./agents/n2b-contract-guard.md",
    "./agents/n2b-ultra.md",
    "./agents/n2b.md",
    "./agents/performance-engineer.md",
    "./agents/postgres-pro.md",
    "./agents/rust-architect.md",
    "./agents/rust-engineer.md",
    "./agents/security-engineer.md",
    "./agents/sre-engineer.md",
    "./agents/yolo-prod-ready.md",
    "./agents/zig-engineer.md"
  ],
  "hooks": "./hooks/hooks.json",
  "mcpServers": {
    "bxc-scrapper": {
      "type": "stdio",
      "command": "bxc-mcp",
      "args": [],
      "env": {
        "BXC_DAEMON_URL": "http://127.0.0.1:8765"
      }
    },
    "github": {
      "type": "streamable-http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "bxc": {
      "type": "stdio",
      "command": "bun",
      "args": [
        "run",
        "C:/src/aphrody/packages/bxc/packages/bxc-extension/server.ts"
      ],
      "env": {
        "BXC_MEMORY_DB": "C:/src/aphrody/var/data/bxc-memory.sqlite"
      }
    },
    "context7": {
      "httpUrl": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}",
        "Accept": "application/json, text/event-stream"
      }
    }
  }
}
