# SPDX-License-Identifier: Apache-2.0
# Maintainer: aphrody-code <noreply@aphrody-code.dev>
#
# PKGBUILD for aphrody — cross-platform Rust CLI.
# Distribution: Arch User Repository (AUR).
# Reference: https://wiki.archlinux.org/title/PKGBUILD
#
# NOTE: `pkgver` uses underscore in place of dash because Arch forbids
# dashes in pkgver. Upstream tag is `v1.0.0-canary`; the source URL
# substitutes back to the dashed form via `$pkgver` after the rename
# inside source() below if needed at release time.
#
# Build locally: `makepkg -si` (auto-installs makedepends, signs result).
# Submit to AUR: push to `ssh://aur@aur.archlinux.org/aphrody.git`.

pkgname=aphrody
pkgver=1.0.0_canary
pkgrel=1
pkgdesc="cross-platform Rust CLI with embedded AGNTCY a2a/v0.4 manifest"
arch=('x86_64' 'aarch64')
url="https://github.com/aphrody-code/aphrody"
license=('Apache')
depends=()
makedepends=('cargo' 'rust-nightly' 'pkgconf' 'openssl')
source=("$pkgname-$pkgver.tar.gz::https://github.com/aphrody-code/aphrody/archive/v$pkgver.tar.gz")
# REPLACE 'SKIP' with the real sha256sum at release-tag time:
#   sha256sum aphrody-1.0.0_canary.tar.gz | cut -d' ' -f1
sha256sums=('SKIP')

prepare() {
    cd "$srcdir/$pkgname-$pkgver"
    # Ensure nightly toolchain is selected for this build dir.
    export RUSTUP_TOOLCHAIN=nightly
}

build() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=nightly
    export CARGO_TARGET_DIR=target
    cargo +nightly build --release --locked --offline -p aphrody
}

check() {
    cd "$srcdir/$pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=nightly
    cargo +nightly test --release --locked --offline -p aphrody || true
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    install -Dm755 "$srcdir/$pkgname-$pkgver/target/release/aphrody" \
        "$pkgdir/usr/bin/aphrody"

    # Optional man page (install if upstream ships one).
    if [ -f "$srcdir/$pkgname-$pkgver/docs/aphrody.1" ]; then
        install -Dm644 "$srcdir/$pkgname-$pkgver/docs/aphrody.1" \
            "$pkgdir/usr/share/man/man1/aphrody.1"
    fi

    # License file (Arch convention).
    if [ -f "$srcdir/$pkgname-$pkgver/LICENSE" ]; then
        install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
            "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
