# SPDX-License-Identifier: Apache-2.0
# Maintainer: aphrody-code <noreply@aphrody-code.dev>
#
# PKGBUILD for aphrody-bin — pre-built binary variant of aphrody.
# Distribution: Arch User Repository (AUR).
# Reference: https://wiki.archlinux.org/title/PKGBUILD
#
# This is the pre-built binary variant; users who want a fast install without
# pulling the full Rust nightly toolchain + workspace deps should prefer this
# package over the source-build `aphrody` PKGBUILD in ../arch/.
#
# `pkgver` uses underscore in place of dash because Arch forbids dashes in
# pkgver. The upstream tag is `v1.0.0-canary`; the release URL is
# reconstructed via `${pkgver/_/-}` below.
#
# Install locally: `makepkg -si`.
# Submit to AUR: push to `ssh://aur@aur.archlinux.org/aphrody-bin.git`.

pkgname=aphrody-bin
pkgver=1.0.0_canary
pkgrel=1
pkgdesc="Cross-platform Rust CLI with embedded AGNTCY a2a/v0.4 manifest (pre-built binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/aphrody-code/aphrody"
license=('Apache')
provides=('aphrody')
conflicts=('aphrody')
depends=('glibc' 'gcc-libs')

source_x86_64=("$pkgname-$pkgver-x86_64.tar.gz::https://github.com/aphrody-code/aphrody/releases/download/v${pkgver/_/-}/aphrody-x86_64-unknown-linux-gnu.tar.gz")
source_aarch64=("$pkgname-$pkgver-aarch64.tar.gz::https://github.com/aphrody-code/aphrody/releases/download/v${pkgver/_/-}/aphrody-aarch64-unknown-linux-gnu.tar.gz")

# REPLACE 'SKIP' with the real sha256sum at release-tag time:
#   sha256sum aphrody-x86_64-unknown-linux-gnu.tar.gz | cut -d' ' -f1
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
  install -Dm755 "$srcdir/aphrody" "$pkgdir/usr/bin/aphrody"

  # Install LICENSE if extracted
  if [ -f "$srcdir/LICENSE" ]; then
    install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  fi

  # Install man page if extracted
  if [ -f "$srcdir/aphrody.1" ]; then
    install -Dm644 "$srcdir/aphrody.1" "$pkgdir/usr/share/man/man1/aphrody.1"
  fi

  # Install shell completions if shipped
  if [ -d "$srcdir/completions" ]; then
    install -Dm644 "$srcdir/completions/aphrody.bash" "$pkgdir/usr/share/bash-completion/completions/aphrody"
    install -Dm644 "$srcdir/completions/_aphrody" "$pkgdir/usr/share/zsh/site-functions/_aphrody"
    install -Dm644 "$srcdir/completions/aphrody.fish" "$pkgdir/usr/share/fish/vendor_completions.d/aphrody.fish"
  fi
}
