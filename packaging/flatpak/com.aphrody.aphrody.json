{
  "app-id": "com.aphrody.aphrody",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-nightly"
  ],
  "command": "aphrody",
  "finish-args": [
    "--share=network",
    "--filesystem=home"
  ],
  "modules": [
    {
      "name": "aphrody",
      "buildsystem": "simple",
      "build-options": {
        "append-path": "/usr/lib/sdk/rust-nightly/bin",
        "env": {
          "CARGO_HOME": "/run/build/aphrody/cargo"
        }
      },
      "build-commands": [
        "cargo build --release --locked --offline -p aphrody",
        "install -Dm755 target/release/aphrody /app/bin/aphrody"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        }
      ]
    }
  ]
}
