      "arm64": {
        "url": "https://github.com/aphrody-code/aphrody/releases/download/v$version/aphrody-v$version-aarch64-pc-windows-msvc.zip",
        "extract_dir": "aphrody-v$version-aarch64-pc-windows-msvc"
      }
    },
    "hash": {
      "url": "$url.sha256",
      "regex": "([a-fA-F0-9]{64})"
    }
  }
}
