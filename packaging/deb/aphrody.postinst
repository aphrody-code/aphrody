#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Copyright 2026 aphrody-code contributors
#
# aphrody — Debian post-install maintainer script (postinst).
# Called by dpkg after the package files are installed to the filesystem.
#
# Spec: POSIX sh, no bash-isms, no interactive prompts, no system service
# start/stop (aphrody is a CLI tool, not a daemon).

set -e

case "$1" in
    configure)
        # $2 is the previously-installed version, empty on first install.
        VERSION=$(dpkg-query --showformat='${Version}' --show aphrody 2>/dev/null || echo "unknown")
        echo "Installed aphrody ${VERSION}; run \`aphrody --help\` to start."
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        ;;
    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

exit 0
