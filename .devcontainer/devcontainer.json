// SPDX-License-Identifier: Apache-2.0
// aphrody one-click Codespace / devcontainer config.
// Spec: https://containers.dev/implementors/json_reference/
// Lowers contribution barrier: open in any devcontainer-compatible editor
// (GitHub Codespaces, VS Code Dev Containers, JetBrains Gateway) and get a
// fully provisioned Rust nightly + wasm + bun + zig + gh toolchain.
{
  "name": "aphrody dev",

  // Official Microsoft Rust devcontainer image — Debian bookworm base,
  // ships rustup, gcc, build-essential, pkg-config out of the box.
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",

  // Layered tooling — composed from the official devcontainers feature catalog.
  // node is intentionally omitted (project policy: bun-only for JS/TS).
  "features": {
    // bun runtime — primary JS/TS scripting + MCP tooling.
    "ghcr.io/devcontainers-extra/features/bun:1": {},

    // zig toolchain — required by cargo-zigbuild for cross-compilation
    // (linux-musl, windows-gnu targets without leaving the container).
    "ghcr.io/devcontainers-extra/features/zig-asdf:1": {},

    // GitHub CLI — needed for gh workflow (PRs, releases, gist, etc.).
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // Post-create provisioning — runs once after the container is built.
  // Installs rust nightly + the 3 priority targets + the cargo extras the
  // CI pipeline expects, then sanity-checks the workspace builds.
  "postCreateCommand": "rustup install nightly && rustup default nightly && rustup target add wasm32-unknown-unknown wasm32-wasip1 x86_64-unknown-linux-gnu && cargo install --locked cargo-nextest cargo-deny cargo-vet cargo-machete cargo-zigbuild cargo-auditable wasm-pack && cargo check -p aphrody --locked --offline 2>&1 | tail -3",

  // Editor wiring — VS Code / Codespaces extensions auto-installed on attach.
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "oven.bun-vscode"
      ]
    }
  },

  // Port forwarding — exposed automatically on the host.
  // 8788 = A2A coord HTTP listener (cf. C:\winclean\.coord\listener.ts,
  //        endpoints /ping /msg /inbox /ai.json — cross-Claude mailbox).
  "forwardPorts": [8788],

  // Non-root user shipped by the base image — sudo-capable, owns /workspaces.
  "remoteUser": "vscode",

  // Codespace machine size hint — Rust nightly + full workspace build +
  // cargo registry cache + target/ easily exceed small-tier defaults.
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "32gb"
  }
}
