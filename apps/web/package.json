{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "description": "Full Material Design 3 React rebuild of Open WebUI — 100% Bun-native (Bun.serve + bun build) on TanStack Router + TanStack Query, rendered with @aphrody/m3-react.",
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build ./src/index.html --outdir dist --minify --target browser",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "smoke": "bun src/smoke.ts"
  },
  "dependencies": {
    "@aphrody/m3-react": "workspace:*",
    "@aphrody/m3-tokens": "workspace:*",
    "@aphrody/material-web": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "firebase": "catalog:",
    "firebase-admin": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bun-types": "catalog:",
    "typescript": "catalog:"
  }
}
