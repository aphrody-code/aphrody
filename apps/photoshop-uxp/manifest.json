{
  "id": "com.aphrody.photoshop",
  "name": "aphrody",
  "version": "1.0.0",
  "main": "index.html",
  "manifestVersion": 5,
  "host": [{ "app": "PS", "minVersion": "24.0.0" }],
  "entrypoints": [
    {
      "type": "panel",
      "id": "aphrodyPanel",
      "label": { "default": "aphrody" },
      "minimumSize": { "width": 230, "height": 200 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 260, "height": 320 },
      "preferredFloatingSize": { "width": 320, "height": 400 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": ["ws://localhost:8765", "ws://127.0.0.1:8765"] },
    "localFileSystem": "fullAccess",
    "allowCodeGenerationFromStrings": true,
    "clipboard": "readAndWrite"
  },
  "icons": []
}
