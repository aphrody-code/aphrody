# systemd unit — run a Rust app binary (alternative to serving static React).
# Install: /etc/systemd/system/aphrody-rust.service  (see deploy-vps.sh --mode rust)
# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=aphrody-managed Rust application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aphrody
Group=aphrody
WorkingDirectory=/opt/aphrody
# APHRODY_RUST_BIN = absolute path to the Rust binary; extra args/env here too.
EnvironmentFile=/etc/aphrody/rust.env
ExecStart=${APHRODY_RUST_BIN}
Restart=always
RestartSec=2

# RAM headroom for the app.
MemoryHigh=2G
MemoryMax=4G
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/aphrody /var/log/aphrody
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
