{
  "name": "@aphrody-code/theme",
  "version": "1.0.0-canary",
  "private": true,
  "description": "Canonical aphrody UI tokens - the Material 3 fusion (M3 + shadcn/ui + Tailwind v4), light + dark. Generated by `aphrody design tokens --fusion`; the single source of truth every first-party aphrody UI imports.",
  "keywords": [
    "aphrody",
    "design-tokens",
    "material-3",
    "shadcn",
    "tailwind"
  ],
  "homepage": "https://github.com/aphrody-code/aphrody-ts/tree/main/apps/theme#readme",
  "bugs": {
    "url": "https://github.com/aphrody-code/aphrody/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-code/aphrody-ts.git",
    "directory": "apps/theme"
  },
  "type": "module",
  "exports": {
    "./tokens.css": "./tokens.css"
  },
  "scripts": {
    "generate": "bun run generate.ts && oxfmt tokens.css",
    "lint": "oxlint",
    "fmt": "oxfmt .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
