{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aphrody",
  "version": "0.1.0",
  "identifier": "dev.aphrody.desktop",
  "build": {
    "beforeDevCommand": "bun run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/desktop/browser"
  },
  "app": {
    "windows": [
      {
        "title": "aphrody",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "msi", "nsis", "app", "dmg"],
    "publisher": "aphrody-code",
    "category": "DeveloperTool",
    "copyright": "Copyright (c) 2026 aphrody-code. Licensed under Apache-2.0.",
    "license": "Apache-2.0",
    "shortDescription": "The cross-platform aphrody agent, in a native desktop shell.",
    "longDescription": "aphrody desktop is the public autonomous agent powered by Gemini. It runs the full aphrody CLI in-process (Rust to Rust, no subprocess) and renders its output in an Angular Material interface: chat, skills, MCP servers, command palette and native voice I/O.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
