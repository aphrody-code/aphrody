{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aphrody",
  "version": "0.1.0",
  "identifier": "dev.aphrody.desktop",
  "build": {
    "beforeDevCommand": "bun run start",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist/desktop/browser"
  },
  "app": {
    "windows": [
      {
        "title": "aphrody",
        "width": 1200,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
