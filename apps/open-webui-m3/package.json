{
  "name": "open-webui-m3",
  "version": "0.0.0",
  "private": true,
  "description": "Full Material Design 3 React rebuild of Open WebUI — 100% Bun-native (Bun.serve + bun build) on TanStack Router + TanStack Query, rendered with @aphrody-code/m3-react.",
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/server.ts",
    "start": "bun src/server.ts",
    "build": "bun build ./src/index.html --outdir dist --minify --target browser",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "smoke": "bun src/smoke.ts"
  },
  "dependencies": {
    "@aphrody-code/m3-react": "^3.2.0",
    "@aphrody-code/m3-tokens": "^3.2.0",
    "@aphrody-code/material-web": "^3.2.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "bun-types": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
