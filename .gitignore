# ============================================================================
#  Aphrody — .gitignore (refreshed 2026-05-21)
#  100% Rust nightly + C/C++ (MSVC FFI wrappers only).
#  JS/TS/Bun/Node/Python are BANNED (cf. CLAUDE.md §2) — patterns kept only
#  to defensively block accidental reintroduction, not to support a toolchain.
#  Order: most-frequent triggers first.
# ============================================================================

# ----------------------------------------------------------------------------
# 0. Runtime / local agent state (never commit)
# ----------------------------------------------------------------------------
ai/heartbeat.txt
.coord/
py/aphrody/cache/
py/ai/heartbeat.txt

# ----------------------------------------------------------------------------
# 1. Rust / Cargo
# ----------------------------------------------------------------------------
target/
**/*.rs.bk
**/*.orig
**/Cargo.lock.tmp
# NOTE: Cargo.lock IS tracked (lockfile-only supply chain since 2026-05-16).
# NOTE: supply-chain/imports.lock IS tracked (cargo-vet feed pins).

# ----------------------------------------------------------------------------
# 2. Bun / Node / npm  (all FORBIDDEN — repo is 100% Rust since 2026-05-18,
#    cf. CLAUDE.md §2 + memory feedback_aphrody_rust_only)
# ----------------------------------------------------------------------------
node_modules/
bun.lock
bun.lockb
bunfig.toml
turbo.json
turbo.jsonc
tsconfig.json
!packages/material-web/labs/gb/tsconfig.json
tsconfig.*.json
.npm/
.npmrc
.yarn/
.yarnrc
.pnp.*
.pnpm-store/
yarn-error.log
yarn-debug.log*
npm-debug.log*
package-lock.json
pnpm-lock.yaml

