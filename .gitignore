# ----------------------------------------------------------------------------
# 20. Internal reports leaked at root (mis-quoted PowerShell Write-Host
#     interpreting backslash escapes in C:\aphrody-backup\* paths).
# ----------------------------------------------------------------------------
/aphrody-backup*
/C:*
/rename-report.json
/rename-dryrun.json
/rename-apply.json
/manifest-scan.json
/tree-scan.json

# ----------------------------------------------------------------------------
# 21. MAX-LIGHT REPO (2026-05-17 pivot+2) — drop ALL vendored upstream sources.
#     ~370 MB cleaned from the git index. Forks are consumed via git+branch=aphrody
#     (cf. Cargo.toml workspace.dependencies and packages/<name>/README.md).
# ----------------------------------------------------------------------------
# vendor/ — keep only the directory placeholder via .gitkeep if needed
vendor/*
!vendor/README.md
!vendor/.gitkeep

# packages — keep only OUR placeholders + work-in-progress (ui, bxc, n2b)
packages/a2ui/*
!packages/a2ui/README.md
packages/gemini-cli/*
!packages/gemini-cli/README.md
packages/material-design-icons/*
!packages/material-design-icons/README.md
packages/material-web/*
!packages/material-web/README.md
packages/next.js/*
!packages/next.js/README.md

# crates/{coreutils,util-linux} — were git submodules pointing to uutils upstream,
# excluded from workspace anyway. Drop entirely (re-clone on demand).
crates/coreutils/
crates/util-linux/

# Pre-commit / Husky / Lefthook config — REMOVED 2026-05-17, no auto hooks.
.pre-commit-config.yaml
.husky/
.lefthook.yml
lefthook.yml

# ----------------------------------------------------------------------------
# 19. Cross-Claude noise sink
# ----------------------------------------------------------------------------
# Peer Claude session in winclean has dropped Steam-monitor screenshots into
# aphrody root twice this session. Off-scope here; canonical location is
# C:/winclean/var/steam-monitor-snapshot*.png. Block at root.
/steam.png
/steam*.png

# ----------------------------------------------------------------------------
# 20. mrx scan artifacts (written into cwd by default)
# ----------------------------------------------------------------------------
# `mrx scan` and `mrx check` write path.json + monorepo-map.json into the
# scanned root by default. They are reproducible outputs of the binary, not
# checked-in artefacts. CI exports them as job outputs; locally they should
# never be committed.
/path.json
/monorepo-map.json
/map.json
