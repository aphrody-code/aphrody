{
  "schema_version": "1.0.0",
  "schema_url": "https://aphrody-code.github.io/aphrody/schemas/ai.json/v1.json",
  "kind": "a2a.AgentCard",
  "id": "aphrody@aphrody-code/aphrody",
  "generated_at": "2026-05-17T14:10:00Z",
  "license": "Apache-2.0",

  "canonical_manifest": {
    "note": "The full A2A CollaborationManifest (AGNTCY a2a v1.0 / lf.a2a.v1 compatible, with AgentCards + skills + tasks + transports) is at `C:/src/aphrody/ai.json` (or `../ai.json` from this file). This `.well-known/ai.json` is the lightweight HTTP-discoverable subset listing only the channels peers use to reach aphrody.",
    "path": "../ai.json",
    "spec": "a2a/v1.0 (lf.a2a.v1) + winclean-coord-ext/1"
  },

  "agent": {
    "name": "aphrody",
    "model": "claude-opus-4-7",
    "provider": "anthropic.com",
    "role": "rust-engineering"
  },

  "workspace": {
    "primary_root": "C:/src/aphrody",
    "primary_root_note": "Canonical clone location per `feedback_clone_path_c_src` (always `C:/src/<repo>`). Override locally by exporting `APHRODY_ROOT`; no Rust code reads `primary_root` directly.",
    "additional_roots_note": "Per-user toolchain caches (cargo, bun, dotnet, nuget) live under the user's home dir. The previous explicit list was a snapshot of the maintainer's machine; resolve at runtime via `$CARGO_HOME` / `$BUN_INSTALL` / `$DOTNET_ROOT` / `$NUGET_PACKAGES`, falling back to `$HOME` / `$USERPROFILE`.",
    "additional_roots": [
      "${CARGO_HOME:-${HOME}/.cargo}",
      "${BUN_INSTALL:-${HOME}/.bun}",
      "${DOTNET_ROOT:-${HOME}/.dotnet}",
      "${NUGET_PACKAGES:-${HOME}/.nuget}"
    ],
    "denied_paths": [
      "**/.ssh/**",
      "**/.aws/**",
      "**/.gnupg/**",
      "**/credentials.json",
      "**/*.pem",
      "**/*.key"
    ],
    "vcs": {
      "kind": "git",
      "remote": "https://github.com/aphrody-code/aphrody",
      "default_branch": "main"
    }
  },

  "platforms": {
    "x86_64-unknown-linux-gnu":   "tier-1",
    "x86_64-pc-windows-msvc":     "tier-1",
    "wasm32-unknown-unknown":     "tier-1",
    "wasm32-wasip1":              "tier-1",
    "aarch64-unknown-linux-gnu":  "tier-2",
    "aarch64-pc-windows-msvc":    "tier-2",
    "x86_64-apple-darwin":        "best-effort",
    "aarch64-apple-darwin":       "best-effort",
    "aarch64-linux-android":      "best-effort"
  },

  "capabilities": [
    "rust-engineering:nightly-1.97",
    "rust-engineering:edition-2024",
    "rust-engineering:resolver-3",
    "wasm-port:wasm32-unknown-unknown",
    "wasm-port:wasm32-wasip1",
    "cargo-supply-chain:deny+vet+auditable",
    "github-releases:multi-target",
    "cross-platform-cli:linux+win+wasm",
    "packaging:scoop+winget+homebrew+install-sh+install-ps1",
    "ffi:bun-bridge",
    "ffi:cxx-bridge",
    "benchmarks:mrx-cli"
  ],

  "exposed_channels": [
    {
      "type": "file_jsonl",
      "direction": "bidirectional",
      "purpose": "asynchronous A2A mailbox (durable, git-friendly) — in-tree canonical depuis 2026-05-19",
      "path": "C:/src/aphrody/ai/",
      "inbox": "ai/inbox.jsonl",
      "outbox": "ai/outbox.jsonl",
      "peer_mirror": {
        "path": "C:/winclean/.coord/",
        "inbox": "inbox-from-aphrody.jsonl",
        "outbox": "inbox-from-winclean.jsonl",
        "note": "Back-compat mirror — peer winclean's source of truth, aphrody appends here best-effort during transition."
      }
    },
    {
      "type": "http_jsonrpc",
      "direction": "inbound",
      "endpoint": "http://localhost:8788",
      "purpose": "Peer-side (winclean) HTTP gateway over its .coord/ — aphrody has no in-tree HTTP listener yet (see PLAN.md R-A R1.4).",
      "routes": [
        { "method": "GET",  "path": "/ping",  "purpose": "liveness + handshake payload" },
        { "method": "POST", "path": "/msg",   "purpose": "append JSON envelope to inbox-from-winclean.jsonl" },
        { "method": "GET",  "path": "/inbox", "purpose": "tail last 50 lines of inbox-from-winclean.jsonl" }
      ]
    },
    {
      "type": "heartbeat_file",
      "direction": "outbound",
      "path": "C:/src/aphrody/ai/heartbeat.txt",
      "peer_mirror_path": "C:/winclean/.coord/heartbeat-aphrody.txt",
      "ttl_seconds": 600,
      "purpose": "proof-of-life timestamp (ISO-8601 UTC) — canonical in-tree, mirrored to peer for back-compat."
    },
    {
      "type": "git_tag",
      "direction": "outbound",
      "repo": "C:/winclean",
      "tag_pattern": "aphrody-*",
      "purpose": "out-of-band signal visible to anyone running `git tag -l aphrody-*`"
    },
    {
      "type": "markdown_doc",
      "direction": "outbound",
      "path": "C:/winclean/.coord/COLLABORATION-APHRODY.md",
      "purpose": "human-readable counterpart to peer's COLLABORATION-IEVR.md"
    },
    {
      "type": "process_inspect",
      "direction": "inbound",
      "purpose": "observability: `ps -ef` lets aphrody detect when peer is actively running shells"
    }
  ],

  "peers": [
    {
      "id": "winclean@aphrody-code/winclean",
      "discovery_hint": "C:/winclean/.well-known/ai.json",
      "trust": "scoped"
    }
  ],

  "etiquette": {
    "envelope_schema": "https://aphrody-code.github.io/aphrody/schemas/ai.json/v1.json#/$defs/envelope",
    "ack_required_for": ["ask"],
    "max_message_kb": 64,
    "rate_limit_per_minute": 60,
    "preferred_language": "fr"
  }
}
