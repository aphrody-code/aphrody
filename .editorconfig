# EditorConfig — Aphrody (Google/Chromium style)
# https://editorconfig.org
root = true

[*]
charset                  = utf-8
end_of_line              = lf
insert_final_newline     = true
trim_trailing_whitespace = true
indent_style             = space
indent_size              = 4

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.{md,mdx}]
trim_trailing_whitespace = false   # markdown line-break = two trailing spaces
indent_size              = 2

[Makefile]
indent_style = tab

[*.rs]
indent_size      = 4
max_line_length  = 100

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf
