{
  "name": "@aphrody/gemini-app-aphrody",
  "version": "0.1.0",
  "private": true,
  "description": "Pixel-perfect Next.js 16 App Router port of https://gemini.google.com/app, wired to the @aphrody/gemini-live-aphrody SDK (OAuth Gemini CLI + Whisper STT + ElevenLabs TTS) and the m3-tokens design system. Voice-first, fork-consumed (link:next), no GEMINI_API_KEY required.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run scripts/copy-fonts.ts && next dev -p 3000",
    "dev:turbo": "bun run scripts/copy-fonts.ts && next dev --turbo -p 3000",
    "build": "bun run scripts/copy-fonts.ts && next build",
    "start": "next start -p 3000",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun tsc --noEmit",
    "test": "bun test tests/",
    "copy-fonts": "bun run scripts/copy-fonts.ts"
  },
  "dependencies": {
    "@aphrody-code/ui": "workspace:*",
    "@aphrody/gemini-live-aphrody": "workspace:*",
    "@material/web": "^2.4.1",
    "material-symbols": "^0.44.7",
    "next": "link:next",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.7",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.6.0"
  }
}
