{
  "name": "@n2b/types",
  "version": "0.5.0",
  "description": "TypeScript types auto-générés depuis schema/v2.json. Source de vérité Rust → TS.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "bunx --bun tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "sideEffects": false
}
