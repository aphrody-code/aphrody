  "private": true,
  "description": "In-process bridge to the aphrody native library (Rust crate aphrody-ffi) via Bun bun:ffi. Drives the ENTIRE aphrody CLI in-process, no subprocess. Requires the cdylib built in the sibling Rust repo (C:\\src\\aphrody): cargo build --release -p aphrody-ffi.",
  "keywords": [
    "aphrody",
    "bun",
    "cli",
    "dlopen",
    "ffi",
    "native"
  ],
  "homepage": "https://github.com/aphrody-code/aphrody-ts/tree/main/packages/native#readme",
  "bugs": {
    "url": "https://github.com/aphrody-code/aphrody/issues"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aphrody-code/aphrody-ts.git",
    "directory": "packages/native"
  },
  "type": "module",
  "module": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt src",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
