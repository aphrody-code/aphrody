{
  "name": "@aphrody/gemini",
  "version": "0.1.0",
  "private": true,
  "description": "Unified Gemini application: Pixel-perfect Next.js 16 App Router port + CLI entrypoint wired to OAuth Gemini CLI + Whisper STT + ElevenLabs TTS.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "dev": "bun run scripts/copy-fonts.ts && next dev -p 3000",
    "dev:turbo": "bun run scripts/copy-fonts.ts && next dev --turbo -p 3000",
    "build": "bun run scripts/copy-fonts.ts && next build",
    "start": "next start -p 3000",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun tsc --noEmit",
    "test": "bun test tests/",
    "copy-fonts": "bun run scripts/copy-fonts.ts"
  },
  "dependencies": {
    "@aphrody-code/ui": "workspace:*",
    "@google/genai": "^2.4.0",
    "@material/web": "^2.4.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "material-symbols": "^0.44.7",
    "next": "github:aphrody-code/next.js#aba947426e2d0943da0eb023162730f74a7c00f9",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.9.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.6.0"
  }
}
