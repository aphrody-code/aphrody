{
  "name": "@n2b/plugin",
  "version": "0.5.0",
  "description": "Plugin Bun (Bun.plugin) + bindings FFI vers bun_ffi.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ffi": "./src/ffi.ts"
  },
  "files": ["src"],
  "scripts": {
    "typecheck": "bunx --bun tsc --noEmit"
