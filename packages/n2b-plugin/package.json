  "dependencies": {
    "@n2b/types": "workspace:*",
    "@n2b/core": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "sideEffects": false
}
