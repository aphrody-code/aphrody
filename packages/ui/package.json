{
	"name": "@aphrody-code/ui",
	"version": "0.2.0",
	"private": true,
	"type": "module",
	"description": "Material Design 3 component wrappers (React 19 + Material Web 3) for aphrody.",
	"main": "./components/index.ts",
	"types": "./components/index.ts",
	"exports": {
		".": {
			"types": "./components/index.ts",
			"import": "./components/index.ts",
			"default": "./components/index.ts"
		},
		"./button": {
			"types": "./components/button.tsx",
			"import": "./components/button.tsx",
			"default": "./components/button.tsx"
		},
		"./button.css": "./components/button.css",
		"./tokens": "./tokens/m3.json",
		"./tokens/m3.json": "./tokens/m3.json",
		"./legacy": "./src/index.ts"
	},
	"files": [
		"components/",
		"src/",
		"tokens/",
		"README.md"
	],
	"scripts": {
		"build:legacy-themes": "bun run scripts/build-all.ts",
		"build:ui": "bun run scripts/build-ui.tsx",
		"build": "bun build ./components/index.ts --outdir ./dist --target browser --format esm --external react --external react-dom --external '@material/web/*'",
		"test": "bun test components/",
		"format": "bun x biome format --write components/ scripts/",
		"scrape:m3": "bun run ../../scripts/scrape-m3-tokens.ts"
	},
	"dependencies": {
		"@material/web": "npm:@material/web@^2.4.1",
		"material-symbols": "^0.44.7"
	},
	"peerDependencies": {
		"react": ">=19.0.0",
		"react-dom": ">=19.0.0"
	},
	"devDependencies": {
		"@happy-dom/global-registrator": "^15.11.7",
		"@types/bun": "latest",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"typescript": "^5.6.0",
		"zod": "^3.23.8"
	}
}
