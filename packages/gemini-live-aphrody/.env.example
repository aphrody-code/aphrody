# SPDX-License-Identifier: Apache-2.0
#
# aphrody/gemini-live-aphrody — environment template.
#
# Copy this file to .env and fill in the values you need for the backend
# you intend to use. NEVER commit a populated .env file.
#
# Two backends are supported. Select with APHRODY_LIVE_BACKEND.
#   - gemini-oauth     : reuse the Gemini CLI's OAuth credentials (no API key).
#   - whisper-gateway  : use local/remote Whisper STT + an OpenAI-compatible
#                        gateway for chat + ElevenLabs for TTS.

# ── Runtime selector ─────────────────────────────────────────────────────────
APHRODY_LIVE_BACKEND=

# ── Backend A: gemini-oauth ──────────────────────────────────────────────────
# Path to the JSON credentials file written by `gemini auth login`.
# Defaults to ~/.gemini/oauth_creds.json when unset.
GEMINI_CREDENTIALS_PATH=
# Optional override for the Gemini model id used by the OAuth backend.
GEMINI_MODEL=

# ── Backend B: whisper-gateway ───────────────────────────────────────────────
# Whisper STT — when OPENAI_API_KEY is set we POST to the OpenAI Whisper
# HTTP API. Otherwise we shell out to a local `whisper` CLI binary.
OPENAI_API_KEY=
WHISPER_BINARY=
WHISPER_MODEL=

# OpenAI-compatible chat completions endpoint (Cloudflare AI Gateway,
# Vercel AI Gateway, OpenAI proxy, local llama.cpp server, etc).
APHRODY_GATEWAY_URL=
APHRODY_GATEWAY_TOKEN=
APHRODY_GATEWAY_MODEL=

# ElevenLabs TTS — used by both backends when voice output is required.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=
