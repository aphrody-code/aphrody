# SPDX-License-Identifier: Apache-2.0
#
# @aphrody/skills — runtime environment overrides
#
# All variables are optional. Defaults resolve relative to the invoking project
# root (for `APHRODY_CC_SKILLS`) or to `C:/worktree/<source>` on Windows /
# `~/worktree/<source>` elsewhere.

# Destination directory for `skills sync` / `skills install`.
# Default: ${HOME or USERPROFILE}/.aphrody/skills/
APHRODY_SKILLS_HOME=

# Comma-separated allowlist of source slugs. Omit to include all 6 sources.
# Valid slugs: open-design, openclaw, claude-code, gemini-cli, vercel-labs, google-labs
APHRODY_SKILLS_SOURCES=

# Per-source path overrides — absolute paths to a directory that contains
# one subdirectory per skill, each with a SKILL.md at its root.
APHRODY_OD_SKILLS=
APHRODY_OC_SKILLS=
APHRODY_CC_SKILLS=
APHRODY_GEMINI_SKILLS=
APHRODY_VERCEL_SKILLS=
APHRODY_GOOGLE_SKILLS=
