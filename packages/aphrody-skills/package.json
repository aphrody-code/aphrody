{
  "name": "@aphrody/skills",
  "version": "0.1.0",
  "description": "Unified skill-aggregator CLI bundling SKILL.md files from open-design, openclaw, claude-code, gemini-cli, vercel-labs and google-labs sources.",
  "license": "Apache-2.0",
  "author": "aphrody-code",
  "homepage": "https://github.com/aphrody-code/aphrody",
  "repository": {
    "type": "git",
    "url": "https://github.com/aphrody-code/aphrody.git",
    "directory": "packages/aphrody-skills"
  },
  "type": "module",
  "private": false,
  "bin": {
    "skills": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./sources": "./src/sources.ts",
    "./manifest": "./src/manifest.ts"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md",
    ".env.example"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "build": "bun build ./src/cli.ts --target=bun --outfile=./dist/cli.js",
    "start": "bun run ./src/cli.ts",
    "typecheck": "bun --bun tsc --noEmit"
  },
  "keywords": [
    "skills",
    "claude-code",
    "gemini-cli",
    "vercel",
    "open-design",
    "openclaw",
    "agent-skills",
    "aphrody"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^6.0.3"
  }
}
