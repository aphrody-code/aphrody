{
  "name": "@aphrody/jsx",
  "version": "0.1.0",
  "description": "Bun-native React reconciler for aphrody-terminal. Emits aphrody-jsx-* OSC sequences instead of ANSI; the aphrody-terminal Rust stack consumes them and renders via taffy + M3 tokens in either a native pty or wasm32 browser target.",
  "license": "Apache-2.0",
  "author": "aphrody-code <noreply@users.noreply.github.com>",
  "homepage": "https://github.com/aphrody-code/aphrody",
  "repository": {
    "type": "git",
    "url": "https://github.com/aphrody-code/aphrody.git",
    "directory": "packages/aphrody-jsx"
  },
  "type": "module",
  "private": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./jsx-runtime": "./src/jsx-runtime.ts",
    "./jsx-dev-runtime": "./src/jsx-dev-runtime.ts",
    "./osc": "./src/osc.ts",
    "./layout": "./src/layout.ts",
    "./m3-tokens": "./src/m3-tokens.ts"
  },
  "files": [
    "src",
    "examples",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun --bun tsc --noEmit",
    "example:hello": "bun run examples/hello.tsx",
    "example:counter": "bun run examples/counter.tsx"
  },
  "keywords": [
    "aphrody",
    "terminal",
    "react",
    "react-reconciler",
    "tui",
    "ink",
    "jsx",
    "bun",
    "osc",
    "m3"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-reconciler": "^0.33.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.0",
    "@types/react-reconciler": "^0.33.0",
    "react": "^19.2.6",
    "react-reconciler": "^0.33.0",
    "typescript": "^6.0.3"
  }
}
